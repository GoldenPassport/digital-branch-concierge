# Copy to .env and fill in your own keys. .env is git-ignored.

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# LangSmith (Settings > API keys). EU accounts use the EU endpoint;
# US accounts use https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=concierge-demo
